# Every Kconfig choice that is not the default, so that a preset run with
# this file (`sanitize`) covers the alternatives while `gcc` and `clang`
# cover the defaults. A new choice option adds its alternative here.
#
# Failed contract assertions go to el_assert_failed(), defined by the
# application; the tests define one that aborts.
EL_CONFIG_ASSERT_HANDLER_APPLICATION=y
# 256-entry CRC tables instead of 16-entry ones.
EL_CONFIG_CRC_TABLE_8BIT=y
# printf accepts the C library's conversions beyond the portable subset.
EL_CONFIG_FMT_PRINTF_LIBC=y
# Not a choice, but a number with one default: log messages are cut at 48
# bytes instead of 128, so the limit that is tested is the configured one.
EL_CONFIG_LOG_MESSAGE_MAX=48
