# The one place that names the Kconfiglib revision Elemental is built with.
#
# Elemental's configuration is generated by the Kconfiglib fork below, used
# through the fork's own CMake package (cmake/Kconfig.cmake in that tree).
# Bump the revision here, re-run `cmake -P tools/provision.cmake`, and run the
# full test suite; nothing else records the revision.
#
# The fork reports the same kconfiglib.VERSION (14.1.0) as upstream Kconfiglib,
# so a version number cannot tell them apart. The build therefore checks the
# checkout's commit, and that Python imports kconfiglib from that checkout.

set(ELEMENTAL_KCONFIGLIB_REPOSITORY "https://github.com/zshoham/kconfiglib.git")
set(ELEMENTAL_KCONFIGLIB_REVISION "242b8ff47f2ad50d2a7985b5d66b165aaad84df3")
