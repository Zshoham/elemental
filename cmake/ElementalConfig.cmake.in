# CMake package for an installed Elemental.
#
#   find_package(Elemental 0.1 REQUIRED COMPONENTS io)
#   target_link_libraries(app PRIVATE elemental::io)
#
# Components are module names, and the names of contract suites (for example
# io_contract). This package is one frozen configuration: a component is
# available only if its module was enabled when the package was built.
#
# A contract suite is GoogleTest source that is compiled into the test that
# links it. The package does not ship GoogleTest: the consumer provides the
# GTest::gtest target, from find_package(GTest) or from its own copy. The resolved configuration is exposed as EL_CONFIG_* variables and
# listed in Elemental_CONFIG_SYMBOLS; the .config it came from is
# Elemental_CONFIG_FILE. Consuming the package needs neither Kconfig nor
# Python unless the consumer enables the literal format check.

@PACKAGE_INIT@

set(_elemental_contract_suites "@ELEMENTAL_CONTRACT_SUITES@")
set(_elemental_modules "@ELEMENTAL_MODULES@" ${_elemental_contract_suites})

# One build may contain one Elemental. Targets that already exist and are not
# imported come from add_subdirectory(); mixing them with this package could
# link two configurations into one program.
foreach(_elemental_module IN LISTS _elemental_modules)
  if(TARGET elemental::${_elemental_module})
    get_target_property(_elemental_imported elemental::${_elemental_module} IMPORTED)
    if(NOT _elemental_imported)
      set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
          "elemental::${_elemental_module} is already defined by an Elemental source tree in this build (add_subdirectory). Use either the source tree or the installed package, not both.")
      return()
    endif()
  endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/ElementalTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/ElementalCheckFormats.cmake")

# The link is by name and resolved when the consumer generates, so it does
# not matter whether GoogleTest is found before or after this package.
foreach(_elemental_suite IN LISTS _elemental_contract_suites)
  set_property(TARGET elemental::${_elemental_suite} APPEND PROPERTY
               INTERFACE_LINK_LIBRARIES GTest::gtest)
endforeach()

# The generated file also sets KCONFIG_SYMBOLS. Load it in a function scope
# and forward only Elemental's names, so a consumer using Kconfig itself keeps
# its own value.
function(_elemental_load_configuration)
  include("${CMAKE_CURRENT_LIST_DIR}/ElementalConfiguration.cmake")
  foreach(_symbol IN LISTS KCONFIG_SYMBOLS)
    set(${_symbol} "${${_symbol}}" PARENT_SCOPE)
  endforeach()
  set(Elemental_CONFIG_SYMBOLS "${KCONFIG_SYMBOLS}" PARENT_SCOPE)
endfunction()
_elemental_load_configuration()
set(Elemental_CONFIG_FILE "${CMAKE_CURRENT_LIST_DIR}/elemental.config")

foreach(_elemental_component IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
  if(_elemental_component IN_LIST _elemental_modules)
    set(${CMAKE_FIND_PACKAGE_NAME}_${_elemental_component}_FOUND TRUE)
  else()
    set(${CMAKE_FIND_PACKAGE_NAME}_${_elemental_component}_FOUND FALSE)
    if(${CMAKE_FIND_PACKAGE_NAME}_FIND_REQUIRED_${_elemental_component})
      string(REPLACE ";" ", " _elemental_available "${_elemental_modules}")
      set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
          "Elemental at ${PACKAGE_PREFIX_DIR} was configured without the '${_elemental_component}' module. Available: ${_elemental_available}. Its configuration is ${Elemental_CONFIG_FILE}.")
    endif()
  endif()
endforeach()

check_required_components(${CMAKE_FIND_PACKAGE_NAME})
