# Elemental configuration.
#
# Symbols are written without a prefix here. Generated C macros and CMake
# variables are named EL_CONFIG_<SYMBOL>.
#
# Each module owns the Kconfig file in its directory. Options are added only
# with a concrete use case, stated in the option's help text.

mainmenu "Elemental configuration"

# Facts about the toolchain. These have no prompt: CMake probes them and
# passes the result in, so a backend cannot be selected for a platform that
# cannot build it.

config PLATFORM_POSIX
	def_bool $(EL_PLATFORM_POSIX)
	help
	  The toolchain provides <unistd.h>. Probed by CMake.

config PLATFORM_SNPRINTF
	def_bool $(EL_PLATFORM_SNPRINTF)
	help
	  The C library has snprintf(), and it converts long long. Probed by
	  CMake: on Zephyr, from the libc's configured printf level.

config COMPILER_GCC_CRC_BUILTINS
	def_bool $(EL_COMPILER_GCC_CRC_BUILTINS)
	help
	  The compiler has __builtin_rev_crc32_data8 and
	  __builtin_crc16_data8 (GCC 15 and later). Probed by CMake.

config PLATFORM_ZEPHYR_CRC
	def_bool $(EL_PLATFORM_ZEPHYR_CRC)
	help
	  A Zephyr build whose <zephyr/sys/crc.h> functions are software that
	  cannot fail: CONFIG_CRC without CONFIG_CRC_HW_HANDLER. Probed by
	  CMake.

config PLATFORM_ZEPHYR
	def_bool $(EL_PLATFORM_ZEPHYR)
	help
	  The build is a Zephyr application's: Zephyr's headers and kernel are
	  there to build against. Probed by CMake.

config COMPILER_ATOMICS
	def_bool $(EL_COMPILER_ATOMICS)
	help
	  The compiler accepts <stdatomic.h>'s acquire load and release store
	  of an _Atomic size_t, the only atomic operations Elemental uses
	  (docs/adr/0023). Probed by CMake.

menu "Modules"

rsource "modules/status/Kconfig"
rsource "modules/io/Kconfig"
rsource "modules/ring/Kconfig"
rsource "modules/alloc/Kconfig"
rsource "modules/bytes/Kconfig"
rsource "modules/crc/Kconfig"
rsource "modules/fmt/Kconfig"
rsource "modules/time/Kconfig"
rsource "modules/log/Kconfig"

endmenu
